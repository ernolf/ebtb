install_debsuryorg_archive_keyring(){
    local deb='debsuryorg-archive-keyring'
    if q0 ${X[dpkg]} -s $deb; then
        return 0
    else
        ${X[curl]} -sSLo /tmp/$deb.deb https://packages.sury.org/$deb.deb
        ${X[dpkg]} -i /tmp/$deb.deb
    fi
}

# add_repository_oneline $1=ubuntu or debian (kept for signature stability, no longer evaluated), $2=codename, $3=package (defaults to php)
add_repository_oneline(){
    local -l codename package gpgfile sources_list_file deb_line
    codename="$2" package="${3:-php}"
    sources_list_file=/etc/apt/sources.list.d/ondrej-sury_$package.list
    install_debsuryorg_archive_keyring
    gpgfile='/usr/share/keyrings/debsuryorg-archive-keyring.gpg'
    deb_line="deb [signed-by=$gpgfile] https://packages.sury.org/$package/ $codename main"
    echo "$deb_line" > $sources_list_file
    apt_update
    populate_can_array
}

# add_repository_deb822 $1=ubuntu or debian, $2=codename, $3=package (defaults to php. can be empty (php) or apache2. NO nginx)
add_repository_deb822(){
    local -l id codename package
    id="$1" codename="$2" package="${3:-php}"
    sources_list_deb822 $id $codename $package > /etc/apt/sources.list.d/ondrej-sury_$package.sources
    apt_update
    populate_can_array
}

# add_repository $1=ubuntu or debian, $2=codename, $3=package (defaults to php)
add_repository(){
    local id codename package
    id="$1" codename="$2" package="${3:-php}"
    if dpkg_min_version apt 2.4; then
        add_repository_deb822 "$id" "$codename" "$package"
    else
        add_repository_oneline "$id" "$codename" "$package"
    fi
}

supported_suites_(){
    (( T[rte] )) || { printf -v T[rte] "%(%s)T" -2; }
    local outfile architecture url exclude suites date_str
    local -i timestamp
    local -a existing_suites
    local -A last_modified
    outfile="$(tf)" architecture="$(${X[dpkg]} --print-architecture)"
    url='https://packages.sury.org/php/dists/' exclude='\.\.'
    ${X[curl]} -so $outfile "$url"
    mapfile -t existing_suites< <(${X[grep]} -oP '(?<=href=")[^"]+(?=/")' "$outfile" | ${X[grep]} -v "$exclude")
    for suites in "${existing_suites[@]}";do
        date_str="$(${X[grep]} "$suites" "$outfile" | ${X[grep]} -oP '\d{4}-\d{2}-\d{2}.*\d{2}:\d{2}|\d{2}-[A-Za-z]{3}-\d{4}.*\d{2}:\d{2}')"
        if [[ -n $date_str ]]; then
            timestamp=$(${X[date]} -d "$date_str" "+%s")
            last_modified["$suites"]=$timestamp
        fi
    done
    ${X[rm]} -f -- $outfile
    for suites in "${!last_modified[@]}"; do
        if (( $(( T[rte] - last_modified[$suites] )) < 3600000 )); then
            if ! ${X[curl]} -s $url$suites/Release | ${X[grep]} -qs "d41d8cd98f00b204e9800998ecf8427e\s*0 main/binary-$architecture/Packages"; then
                echo "$suites"
            fi
        fi
    done
}

sury(){
    # assess the configured apt sources for Ondřej Surý's php repo.
    # since https://codeberg.org/oerdnj/deb.sury.org/issues/73 there is only ONE
    # correct URI pattern for debian AND ubuntu: https://packages.sury.org/php/
    # the old launchpad PPA URIs are recognized as legacy sources.
    # the return code is a bitmask, 1-31 combine, 0/32/64/128 are exclusive:
    #    0 = OK: 1 or more correct apt sources, nothing to complain about
    #    1 = 1 or more legacy sources (old ubuntu launchpad ppa URI)
    #    2 = 1 or more wrong suites (apt source codename)
    #    4 = 1 or more wrong protocol (http instead of https)
    #    8 = 1 or more wrong architecture
    #   16 = no correct apt source (only in combination with 1, 2, 4 or 8)
    #   32 = no sury repo detected
    #   64 = Not-OK: no apt sources at all
    #  128 = unknown distributor
    # stdout: one verdict per assessed source as ' - N = <verdict> (<bit>)' where
    # N is the position in apt_cache_policy (list_sources_short_numerated relies
    # on the ' N = ok' token to colorize its listing)
    local -i r i found ok
    local -l id codename arch arch_regex legacy_regex sury_org_uri return
    local -a archs sources
    r=0 found=0 ok=0
    sury_org_uri='https://packages.sury.org/php'
    legacy_regex='^https?://ppa\.launchpad(content)?\.net/ondrej/php/ubuntu/?$'
    [ -f "${F[os]:="${D[vt]}/os"}" ] && . "${F[os]}"
    if q0 tnh1_strg sury; then # OS is supported!
        id="$(q2 tnh1 3 | ${X[gawk]} '{print $(NF-1)}')"
        codename="$(q2 tnh1 3 | ${X[gawk]} '{print $(NF)}')"
    else
        codename="${OS[version_codename]}"
        case ${OS[id]} in
ubuntu|debian|raspbian) : ;;
                     *) if [ -n "${OS[id_like]}" ]; then
                            case ${OS[id_like]% *} in
                 ubuntu|debian)
                                    if [ -n "${OS[debian_codename]}" ]; then
                                        codename="${OS[debian_codename]}"
                                    elif [ -n "${OS[ubuntu_codename]}" ]; then
                                        codename="${OS[ubuntu_codename]}"
                                    fi
                                    ;;
                                *)  codename='' return="unknown distributor ${OS[id]}"
                            esac
                        else
                            codename='' return="unknown distributor ${OS[id]}"
                        fi
        esac
    fi
    if [[ -z $codename || -z "${X[dpkg]}" ]]; then
        printf "${return:-unknown distributor}"
        return 128
    fi
    arch="$(${X[dpkg]} --print-architecture)"
    mapfile -t archs< <(p_sort $arch $(q2 ${X[dpkg]} --print-foreign-architectures))
    arch_regex="$(echo ${archs[@]} | ${X[tr]} ' ' '|')"
    mapfile -t sources< <(apt_cache_policy)
    if ! (( ${#sources[@]} )); then # no sources at all, this indicates an error
        printf 'Not-OK'
        return 64
    fi
    for i in ${!sources[@]}; do
        unset rank uri a c v o l b n origin
        eval local ${sources[i]}
        if [[ $uri =~ $legacy_regex ]]; then
            (( r |= 1 )); return="$return - $(( i + 1 )) = legacy ubuntu ppa source (1)"
        elif [[ ${uri%/} == $sury_org_uri ]]; then
            if [[ $n != $codename ]]; then
                (( r |= 2 )); return="$return - $(( i + 1 )) = $n instead of $codename (2)"
            elif [[ ! $b =~ $arch_regex ]]; then
                (( r |= 8 )); return="$return - $(( i + 1 )) = wrong architecture (8)"
            else
                ok=1 return="$return - $(( i + 1 )) = ok (0)"
            fi
        elif [[ ${uri%/} == ${sury_org_uri/https/http} ]]; then
            (( r |= 4 )); return="$return - $(( i + 1 )) = http instead of https (4)"
        else
            continue
        fi
        found=1
    done
    if ! (( found )); then
        r=32 return="No sury repo detected"
    elif ! (( ok )); then
        (( r |= 16 )); return="$return - no correct sury apt source (16)"
    fi
    printf "$return"
    return $r
}

# every user-facing message of this module lives here, keyed by a case string.
# per-file action messages (ipf, 'I:') take $2=file, $3=codename, $4=suites;
# free-standing paragraphs and one-liners take no further arguments.
sury_message_(){
    local case aptsources_file codename suites deactivated
    case="$1" aptsources_file="$2" codename="$3" suites="$4"
    deactivated="${aptsources_file%.*}_deactivated.${aptsources_file##*.}"
    case "$case" in
        fix_yourself_if_fails)
            local string
            string="If this step fails, you should fix it yourself please. Do not run this step multiple times then. If it doesn't work after one attempt, it won't work on the second and subsequent attempts either. It will propably be fixed though in a future version of this script, so you can run this script again at a later time to try again if it fails now."
            echo "$(o3; GRAY; format_string "$string" 3; N)"
            ;;
        visit_website)
            echo "$(os; GRAY; echo "Visit Ondřej Surý's website: $(W)https://deb.sury.org/$(GRAY) for more details."; N)"
            ;;
        no_sury_for_os)
            echo "$(os; Y; echo "There exists no Ondřej Surý repo for your OS version"; N)"
            ;;
        consider_add)
            echo "$(pf; Y; format_string "Consider adding Ondřej Surý's repo to your Apt sources to expand the range of installable PHP candidates" 3; N)"
            ;;
        no_apt_sources)
            echo "$(os; R; echo "Not a single apt source could be detected on this system. Please fix your apt configuration yourself."; N)"
            ;;
        unknown_distributor)
            echo "$(os; Y; echo "Your distribution could not be identified reliably, no changes will be made to your apt sources."; N)"
            ;;
        legacy_ppa_intro)
            echo "$(pf; format_string "Ondřej Surý's repo is added to your apt sources but it still points to the old launchpad PPA server. Ondřej Surý is moving his Ubuntu packages from the launchpad PPA to his own package server $(B)https://packages.sury.org/$(N) - see $(W)https://codeberg.org/oerdnj/deb.sury.org/issues/73$(N) for details - and the PPA will stop receiving updates, apt already reports its changed label." 3; N)"
            ;;
        legacy_ppa)
            echo "$(ipf; format_string "the sources-file $(C)$aptsources_file$(N) still points to the old launchpad PPA server. The file will be deactivated and renamed to $(C)$deactivated$(N) and a new sources-file pointing to $(B)packages.sury.org$(N) will be created for $(Y)$codename$(N). Please remove the old file afterwards if everything functions as expected." 3)"
            ;;
        wrong_protocol)
            echo "$(ipf; format_string "the sources-file $(C)$aptsources_file$(N) is using the deprecated unencrypted $(C)http://$(N) protocol instead of $(B)https://$(N). The file will be deactivated and renamed to $(C)$deactivated$(N) and a new sources-file using $(B)https://$(N) will be created. Please remove the old file afterwards if everything functions as expected." 3)"
            ;;
        old_key)
            echo "$(ipf; format_string "the sources-file $(C)$aptsources_file$(N) is using an old public pgp key. The file will be deactivated and renamed to $(C)$deactivated$(N) and a new sources-file using the currently valid public pgp key will be created. Please remove the old file afterwards if everything functions as expected." 3)"
            ;;
        unknown_key)
            echo "$(ipf; format_string "the sources-file $(C)$aptsources_file$(N) is not using the currently valid public pgp key. The file will be deactivated and renamed to $(C)$deactivated$(N) and a new sources-file will be created using the currently valid public pgp key. Please remove the old file afterwards if everything functions as expected." 3)"
            ;;
        old_key_wrong_suites|unknown_key_wrong_suites)
            echo "$(ipf; format_string "the sources-file $(C)$aptsources_file$(N) is created for $(Y)$suites$(N) instead of $(Y)$codename$(N) and additionally not using the currently valid public pgp key. The file will be deactivated and renamed to $(C)$deactivated$(N) and a new sources-file will be created for $(Y)$codename$(N) using the currently valid public pgp key. Please remove the old file afterwards if everything functions as expected." 3)"
            ;;
        wrong_suites)
            echo "$(ipf; format_string "the sources-file $(C)$aptsources_file$(N) is created for $(Y)$suites$(N) instead of $(Y)$codename$(N). The file will be deactivated and renamed to $(C)$deactivated$(N) and a new sources-file will be created for $(Y)$codename$(N) using the currently valid public pgp key. Please remove the old file afterwards if everything functions as expected." 3)"
            ;;
    esac
}

# helper: populate three arrays with every enabled sury related apt source entry,
# one-line (.list) AND deb822 (.sources) files alike, deduplicated per uri+suite+file
# populate_sury_sources_ <uris array name> <suites array name> <files array name>
populate_sury_sources_(){
    local -n _uris=$1
    local -n _suites=$2
    local -n _files=$3
    local uri suite comp file
    local -i r
    local -A seen
    r=1
    while IFS=$'\t' read -r uri suite comp file; do
        [[ $uri =~ (ondrej|sury) ]] || continue
        [ -n "${seen[$uri|$suite|$file]}" ] && continue
        seen[$uri|$suite|$file]=:
        r=0 _uris+=("$uri") _suites+=("$suite") _files+=("$file")
    done < <(apt_sources_py)
    return $r
}

# helper: classify one sury apt source entry; prints exactly one case string:
# legacy_ppa | wrong_protocol | old_key | old_key_wrong_suites | unknown_key |
# unknown_key_wrong_suites | wrong_suites | ok
# sury_source_classify_ $1=uri, $2=suite, $3=file, $4=codename, $5=ubuntu or debian
sury_source_classify_(){
    local fpr old_fprs
    local -l uri suite file codename id
    local -A bool
    uri="${1%/}" suite="$2" file="$3" codename="$4" id="$5"
    [[ $suite != $codename ]] && bool[wrong_suites]=: || bool[wrong_suites]=_
    if [[ $uri =~ ^https?://ppa\.launchpad(content)?\.net/ondrej/ ]]; then
        echo legacy_ppa
    elif [[ $uri == http://* ]]; then
        echo wrong_protocol
    elif [[ $file == *'.sources' ]] && fpr="$(gpg_extract_ fpr "$file")" && [[ $fpr != "$(gpg_extract_ fpr sury_org_key)" ]]; then
        old_fprs="$(gpg_extract_ fpr sury_${id}_old_key)"
        q0 type sury_${id}_old_old_key && old_fprs="$old_fprs $(gpg_extract_ fpr sury_${id}_old_old_key)"
        if [[ " $old_fprs " == *" $fpr "* ]]; then
            ${bool[wrong_suites]} && echo old_key_wrong_suites || echo old_key
        else
            ${bool[wrong_suites]} && echo unknown_key_wrong_suites || echo unknown_key
        fi
    elif ${bool[wrong_suites]}; then
        echo wrong_suites
    else
        echo ok
    fi
}

# check ALL sury related apt sources files and repair them where necessary.
# legacy launchpad ppa sources, old or unknown pgp keys, wrong suites and http
# URIs are all cured the same way: the affected file is deactivated and a fresh
# sources-file for $codename pointing to packages.sury.org with the currently
# valid public pgp key is created (once per package).
# sury_sources_check $1=ubuntu or debian, $2=codename, $3=name of a bool array
sury_sources_check(){
    local as_file case package new_file
    local -l id codename as_uri as_suite
    id="$1" codename="$2"
    local -n _bool=$3
    local -a as_uris as_suites as_files as_changed as_success fixed failed
    local -A recreated treated
    local -i i
    populate_sury_sources_ as_uris as_suites as_files || return 0
    for i in "${!as_files[@]}"; do
        as_uri="${as_uris[i]}" as_suite="${as_suites[i]}" as_file="${as_files[i]}" as_changed[i]=_ as_success[i]=:
        # a file with multiple suites yields multiple entries - treat each file only once
        [ -n "${treated[$as_file]}" ] && continue
        [ -f "$as_file" ] || continue
        case="$(sury_source_classify_ "$as_uri" "$as_suite" "$as_file" "$codename" "$id")"
        [ "$case" = 'ok' ] && continue
        package="$(sed_ 's#.*(ppa\.launchpad[^/]*\.net/ondrej/|packages\.sury\.org/)([^/]+).*#\2#p' "$as_uri" '-')"
        package="${package:-php}"
        bundle echo "$(sury_message_ $case "$as_file" "$codename" "$as_suite")"
        f
        anykey
        f
        if apt_deactivate_sources_file "$as_file"; then
            treated[$as_file]=: as_changed[i]=:
            [ -n "${recreated[$package]}" ] || { add_repository "$id" "$codename" "$package" && recreated[$package]=:; }
            new_file="/etc/apt/sources.list.d/ondrej-sury_$package.sources"
            [ -f "$new_file" ] || new_file="/etc/apt/sources.list.d/ondrej-sury_$package.list"
            as_files[i]="$new_file"
            if [ -f "$new_file" ] && ${X[grep]} -qsw "$codename" "$new_file" \
                && { [[ $new_file == *'.list' ]] || [[ "$(gpg_extract_ fpr "$new_file")" == "$(gpg_extract_ fpr sury_org_key)" ]]; }; then
                mh "$(fn_ln) recreation of $as_file as $new_file succeeded"
            else
                as_success[i]=_
                mh "$(fn_ln) recreation of $as_file as $new_file failed"
            fi
        else
            as_success[i]=_
        fi
    done
    for i in ${!as_changed[@]}; do
        if ${as_changed[i]}; then
            ${as_success[i]} && fixed+=("${as_files[i]}") || failed+=("${as_files[i]}")
        elif ! ${as_success[i]}; then
            failed+=("${as_files[i]}")
        fi
    done
    (( ${#fixed[@]} + ${#failed[@]} )) || return 0
    if (( ${#fixed[@]} )); then
        os; G; echo "Recreation of apt sources file was successfull for:"
        for i in ${!fixed[@]}; do
            os; pf; C; echo "${fixed[i]}"
        done; N
    fi
    if (( ${#failed[@]} )); then
        os; R; echo "Unfortunately recreation of apt sources file was not successfull for:"
        for i in ${!failed[@]}; do
            os; pf; P; echo "${failed[i]}"
        done
        os; R; echo "Please fix it yourself."; N
    fi
    if [[ "${as_changed[@]}" =~ : ]]; then
        apt_update
        . "${F[php]}"
        mh "$(fn_ln) after apt source recreation: $(declare -p CAN)"
        _bool[changed]=:
    fi
    f
    anykey
}

need_sury_repo(){
    local sury_return id codename
    local -i sury_r
    local -A bool
    [ -f "${F[php]:="${D[vt]}/php"}" ] && . "${F[php]}"
    mh "$(fn_ln) start: $(declare -p CAN)"
    bool[changed]=_
    if tnh1_strg sury; then # OS is supported!
        id="$(tnh1 3 | ${X[gawk]} '{print $(NF-1)}')"
        codename="$(tnh1 3 | ${X[gawk]} '{print $(NF)}')"
        list_apt_sources show_sury
        anykey_noquit
        f
        separator
        list_candidates
        f
        sury_return="$(sury)"
        sury_r=$?
        if (( sury_r == 32 )); then # no sury repo
            sury_message_ consider_add
            f
            sury_message_ visit_website
            f
            os; echo "This script can add the right repo to your apt sources."
            sury_message_ fix_yourself_if_fails
            if ask "$(qpf)Do you want to add sury repo now" "$YES"; then
                [ -z "${PHP[v]}" ] || switch_php_to_ "${PHP[v]}"
                add_repository "$id" "$codename"
                sury_return="$(sury)"
                sury_r=$?
                if ((sury_r == 32)); then # still no sury repo
                    mh "$(fn_ln) adding apt source failed"
                    f
                    os; R; echo "Unfortunately this step was not successfull. Please add the apt source yourself."; N
                    anykey
                else
                    . "${F[php]}"
                    mh "$(fn_ln) adding apt source succeeded"
                    mh "$(fn_ln) after apt source added: $(declare -p CAN)"
                    bool[changed]=:
                    os; G; echo "adding apt source was successfull"; N
                    anykey
                fi
            fi
        elif (( sury_r == 64 )); then # no apt sources at all
            sury_message_ no_apt_sources
            f
            anykey
        elif (( sury_r == 128 )); then # unknown distributor
            sury_message_ unknown_distributor
            f
            anykey
        else # 0 or any problem bits: verify the sury sources files and repair where necessary
            if (( sury_r & 1 )); then # 1 or more legacy launchpad ppa sources found
                sury_message_ legacy_ppa_intro
                f
            fi
            sury_sources_check "$id" "$codename" bool
        fi
        if ${bool[changed]}; then
            os; G; echo "After made changes.."
            list_apt_sources show_sury
            anykey_noquit
            f
            separator
            list_candidates
            f
        fi
    else
        sury_message_ no_sury_for_os
        sury_message_ visit_website
        f
    fi
}
